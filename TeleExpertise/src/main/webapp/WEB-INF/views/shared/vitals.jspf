<h2 class="h5 mt-4">Signes vitaux</h2><div class="row g-3">
<div class="col-md-4"><label class="form-label">Tension artérielle (mmHg)</label><input class="form-control" name="bloodPressure" placeholder="120/80" maxlength="20" required value="<c:out value='${param.bloodPressure}'/>"></div>
<div class="col-md-4"><label class="form-label">Fréquence cardiaque (/min)</label><input class="form-control" type="number" name="heartRate" min="1" max="300" required value="<c:out value='${param.heartRate}'/>"></div>
<div class="col-md-4"><label class="form-label">Température (°C)</label><input class="form-control" type="number" name="temperature" min="25" max="45" step="0.1" required value="<c:out value='${param.temperature}'/>"></div>
<div class="col-md-4"><label class="form-label">Fréquence respiratoire (/min)</label><input class="form-control" type="number" name="respiratoryRate" min="1" max="100" required value="<c:out value='${param.respiratoryRate}'/>"></div>
<div class="col-md-4"><label class="form-label">Poids (kg, facultatif)</label><input class="form-control" type="number" name="weight" min="0.01" max="500" step="0.01" value="<c:out value='${param.weight}'/>"></div>
<div class="col-md-4"><label class="form-label">Taille (cm, facultatif)</label><input class="form-control" type="number" name="height" min="0.01" max="500" step="0.01" value="<c:out value='${param.height}'/>"></div></div>
