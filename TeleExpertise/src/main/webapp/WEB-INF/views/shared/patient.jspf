<section class="card card-body mb-4"><h2 class="h5">Dossier de <c:out value="${patient.fullName}"/></h2><div class="row"><div class="col-md-6"><p>Né(e) le <c:out value="${patient.birthDate}"/> · N° SS : <c:out value="${patient.socialSecurityNumber}"/></p><p>Téléphone : <c:out value="${patient.phone}"/></p><p>Adresse : <c:out value="${patient.address}"/></p><p>Mutuelle : <c:out value="${patient.insurance}"/></p></div><div class="col-md-6"><p>Antécédents : <c:out value="${patient.history}"/></p><p>Allergies : <c:out value="${patient.allergies}"/></p><p>Traitements en cours : <c:out value="${patient.currentTreatment}"/></p></div></div>
<h3 class="h6">Historique des signes vitaux</h3><div class="table-responsive"><table class="table"><thead><tr><th>Date</th><th>Tension</th><th>Pouls</th><th>Température</th><th>Respiration</th><th>Poids</th><th>Taille</th></tr></thead><tbody><c:forEach items="${patient.vitalSigns}" var="v"><tr><td><c:out value="${v.recordedAt}"/></td><td><c:out value="${v.bloodPressure}"/></td><td>${v.heartRate}</td><td>${v.temperature} °C</td><td>${v.respiratoryRate}</td><td>${v.weight} kg</td><td>${v.height} cm</td></tr></c:forEach></tbody></table></div></section>
