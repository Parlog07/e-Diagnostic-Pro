<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ include file="../shared/header.jspf" %>
<p class="eyebrow">ESPACE INFIRMIER</p><h1>Nouveau patient</h1><p class="text-muted">Le patient est ajouté automatiquement à la file d'attente.</p><form class="card card-body" method="post" action="${ctx}/nurse/patients"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="action" value="register"><div class="row g-3">
<div class="col-md-6"><label class="form-label">Prénom</label><input class="form-control" name="firstName" type="text" required maxlength="100" value="<c:out value='${param.firstName}'/>"></div><div class="col-md-6"><label class="form-label">Nom</label><input class="form-control" name="lastName" type="text" required maxlength="100" value="<c:out value='${param.lastName}'/>"></div><div class="col-md-6"><label class="form-label">Date de naissance</label><input class="form-control" name="birthDate" type="date" required maxlength="10" value="<c:out value='${param.birthDate}'/>"></div><div class="col-md-6"><label class="form-label">Numéro de sécurité sociale</label><input class="form-control" name="socialSecurityNumber" type="text" required maxlength="50" value="<c:out value='${param.socialSecurityNumber}'/>"></div><div class="col-md-6"><label class="form-label">Téléphone</label><input class="form-control" name="phone" type="text"  maxlength="30" value="<c:out value='${param.phone}'/>"></div><div class="col-md-6"><label class="form-label">Adresse</label><input class="form-control" name="address" type="text"  maxlength="300" value="<c:out value='${param.address}'/>"></div><div class="col-md-6"><label class="form-label">Mutuelle</label><input class="form-control" name="insurance" type="text"  maxlength="100" value="<c:out value='${param.insurance}'/>"></div>
</div><div class="row g-3 mt-1"><div class="col-md-4"><label class="form-label">Antécédents</label><textarea class="form-control" name="history" maxlength="3000"><c:out value="${param.history}"/></textarea></div><div class="col-md-4"><label class="form-label">Allergies</label><textarea class="form-control" name="allergies" maxlength="1000"><c:out value="${param.allergies}"/></textarea></div><div class="col-md-4"><label class="form-label">Traitements en cours</label><textarea class="form-control" name="currentTreatment" maxlength="3000"><c:out value="${param.currentTreatment}"/></textarea></div></div><%@ include file="../shared/vitals.jspf" %><div class="mt-4"><button class="btn btn-primary">Enregistrer le patient</button><a class="btn btn-light" href="${ctx}/nurse/patients">Retour</a></div></form>
<%@ include file="../shared/footer.jspf" %>
