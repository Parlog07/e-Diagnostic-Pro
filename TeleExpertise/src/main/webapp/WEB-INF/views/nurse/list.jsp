<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ include file="../shared/header.jspf" %>
<div class="page-heading"><div><p class="eyebrow">ESPACE INFIRMIER</p><h1><c:out value="${search ? 'Recherche de patients' : 'Patients du jour'}"/></h1><p class="text-muted">Arrivées et état de la prise en charge.</p></div><a class="btn btn-primary" href="${ctx}/nurse/patients?action=new">Nouveau patient</a></div>
<form class="search-row" method="get" action="${ctx}/nurse/patients"><input type="hidden" name="action" value="search"><input class="form-control" name="q" placeholder="Nom, prénom ou numéro de sécurité sociale" maxlength="100" value="<c:out value='${param.q}'/>"><button class="btn btn-outline-primary">Rechercher</button><a class="btn btn-light" href="${ctx}/nurse/patients">Aujourd'hui</a></form>
<div class="card card-body"><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Patient</th><th>N° SS</th><th>Arrivée</th><th>Derniers signes</th><th>État</th><th></th></tr></thead><tbody><c:forEach items="${patients}" var="p"><tr><td><c:out value="${p.fullName}"/></td><td><c:out value="${p.socialSecurityNumber}"/></td><td><c:out value="${p.arrivalAt}"/></td><td><c:if test="${not search and not empty p.vitalSigns}"><c:out value="${p.vitalSigns[0].bloodPressure}"/> · ${p.vitalSigns[0].heartRate}/min · ${p.vitalSigns[0].temperature} °C</c:if></td><td><span class="badge text-bg-light"><c:out value="${p.waiting ? 'En attente' : 'Pris en charge'}"/></span></td><td><a href="${ctx}/nurse/patients?action=record&id=${p.id}">Ouvrir le dossier</a></td></tr></c:forEach></tbody></table></div><c:if test="${empty patients}"><p class="empty-state">Aucun patient à afficher.</p></c:if></div>
<%@ include file="../shared/footer.jspf" %>
