<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ include file="../shared/header.jspf" %>
<p class="eyebrow">ESPACE SPÉCIALISTE</p><h1>Demandes d'expertise</h1><form method="get" action="${ctx}/specialist/requests" class="search-row"><select class="form-select" name="status"><option value="">Tous les statuts</option><option value="EN_ATTENTE" ${param.status == 'EN_ATTENTE' ? 'selected' : ''}>En attente</option><option value="TERMINEE" ${param.status == 'TERMINEE' ? 'selected' : ''}>Terminées</option></select><select class="form-select" name="priority"><option value="">Toutes les priorités</option><option value="URGENTE" ${param.priority == 'URGENTE' ? 'selected' : ''}>Urgente</option><option value="NORMALE" ${param.priority == 'NORMALE' ? 'selected' : ''}>Normale</option><option value="NON_URGENTE" ${param.priority == 'NON_URGENTE' ? 'selected' : ''}>Non urgente</option></select><button class="btn btn-outline-primary">Filtrer</button></form><div class="card card-body"><div class="table-responsive"><table class="table"><thead><tr><th>Patient</th><th>Généraliste</th><th>Priorité</th><th>Statut</th><th></th></tr></thead><tbody><c:forEach items="${requests}" var="r"><tr><td><c:out value="${r.consultation.patient.fullName}"/></td><td><c:out value="${r.consultation.doctor.fullName}"/></td><td><c:out value="${r.priority}"/></td><td><c:out value="${r.status}"/></td><td><a href="${ctx}/specialist/requests?action=details&id=${r.id}">Ouvrir</a></td></tr></c:forEach></tbody></table></div><c:if test="${empty requests}"><p class="empty-state">Aucune demande pour ce filtre.</p></c:if></div>
<%@ include file="../shared/footer.jspf" %>
