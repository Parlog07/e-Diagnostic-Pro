<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ include file="../shared/header.jspf" %>
<h1>Répondre à une expertise</h1><%@ include file="../shared/consultation.jspf" %><section class="card card-body mb-4"><h2 class="h5">Question du généraliste</h2><p><c:out value="${expertise.question}"/></p><p>Priorité : <c:out value="${expertise.priority}"/> · Statut : <c:out value="${expertise.status}"/></p></section>
<c:choose><c:when test="${expertise.status == 'EN_ATTENTE'}"><form class="card card-body" method="post" action="${ctx}/specialist/requests"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="action" value="respond"><input type="hidden" name="id" value="${expertise.id}"><label class="form-label">Avis médical</label><textarea class="form-control mb-3" name="opinion" maxlength="3000" required></textarea><label class="form-label">Recommandations</label><textarea class="form-control mb-3" name="recommendations" maxlength="3000" required></textarea><div><button class="btn btn-primary">Terminer l'expertise</button></div></form></c:when><c:otherwise><section class="card card-body"><h2 class="h5">Avis transmis</h2><p><c:out value="${expertise.opinion}"/></p><p><c:out value="${expertise.recommendations}"/></p></section></c:otherwise></c:choose><p class="mt-4"><a href="${ctx}/specialist/requests">Retour</a></p>
<%@ include file="../shared/footer.jspf" %>
