<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ include file="../shared/header.jspf" %>
<p class="eyebrow">ESPACE GÉNÉRALISTE</p><h1>Consultations</h1><section class="card card-body mb-4"><h2 class="h5">File d'attente</h2><table class="table"><thead><tr><th>Patient</th><th>Arrivée</th><th></th></tr></thead><tbody><c:forEach items="${waiting}" var="p"><tr><td><c:out value="${p.fullName}"/></td><td><c:out value="${p.arrivalAt}"/></td><td><a href="${ctx}/doctor/consultations?action=record&patientId=${p.id}">Ouvrir le dossier</a></td></tr></c:forEach></tbody></table><c:if test="${empty waiting}"><p class="empty-state">Aucun patient en attente.</p></c:if></section>
<section class="card card-body"><h2 class="h5">Mes consultations</h2><div class="table-responsive"><table class="table"><thead><tr><th>Patient</th><th>Motif</th><th>Statut</th><th></th></tr></thead><tbody><c:forEach items="${consultations}" var="c"><tr><td><c:out value="${c.patient.fullName}"/></td><td><c:out value="${c.reason}"/></td><td><c:out value="${c.status}"/></td><td><a href="${ctx}/doctor/consultations?action=details&id=${c.id}">Détails</a></td></tr></c:forEach></tbody></table></div><c:if test="${empty consultations}"><p class="empty-state">Aucune consultation pour le moment.</p></c:if></section>
<%@ include file="../shared/footer.jspf" %>
