<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ include file="../shared/header.jspf" %>
<h1>Détails de la consultation</h1><%@ include file="../shared/consultation.jspf" %>
<c:if test="${consultation.status == 'EN_COURS' or consultation.status == 'AVIS_RECU'}">
<form class="card card-body mb-4" method="post" action="${ctx}/doctor/consultations"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="id" value="${consultation.id}"><h2 class="h5">Prise en charge</h2><label class="form-label">Observations</label><textarea class="form-control mb-3" name="observations" maxlength="3000"><c:out value="${consultation.observations}"/></textarea><label class="form-label">Diagnostic</label><textarea class="form-control mb-3" name="diagnosis" maxlength="3000"><c:out value="${consultation.diagnosis}"/></textarea><label class="form-label">Traitement</label><textarea class="form-control mb-3" name="treatment" maxlength="3000"><c:out value="${consultation.treatment}"/></textarea><div><button class="btn btn-outline-primary" name="action" value="update">Enregistrer</button> <button class="btn btn-primary" name="action" value="finish">Clôturer</button></div></form>
<form class="card card-body mb-4" method="post" action="${ctx}/doctor/consultations"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="id" value="${consultation.id}"><input type="hidden" name="action" value="act"><h2 class="h5">Ajouter un acte technique</h2><div class="row g-3"><div class="col-md-7"><label class="form-label">Acte</label><input class="form-control" name="name" placeholder="Ex. Radiographie" maxlength="200" required></div><div class="col-md-3"><label class="form-label">Prix (DH)</label><input class="form-control" type="number" name="price" min="0" step="0.01" required></div><div class="col-md-2 d-flex align-items-end"><button class="btn btn-primary">Ajouter</button></div></div></form>
<c:if test="${empty consultation.expertiseRequest}">
<section class="card card-body mb-4"><h2 class="h5">Demander un avis spécialiste</h2><p class="text-muted">Avis écrit. La réservation de créneaux est hors périmètre.</p><form method="get" action="${ctx}/doctor/consultations" class="search-row"><input type="hidden" name="action" value="details"><input type="hidden" name="id" value="${consultation.id}"><input class="form-control" name="specialty" maxlength="100" placeholder="Rechercher une spécialité" value="<c:out value='${param.specialty}'/>"><button class="btn btn-outline-primary">Filtrer</button></form>
<form method="post" action="${ctx}/doctor/consultations"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="id" value="${consultation.id}"><input type="hidden" name="action" value="request"><label class="form-label">Spécialiste (tri par tarif croissant)</label><select class="form-select mb-3" name="specialistId" required><option value="">Choisir</option><c:forEach items="${specialists}" var="s"><option value="${s.id}"><c:out value="${s.fullName}"/> · <c:out value="${s.specialty}"/> · ${s.tariff} DH</option></c:forEach></select><label class="form-label">Priorité</label><select class="form-select mb-3" name="priority"><option value="NORMALE">Normale</option><option value="URGENTE">Urgente</option><option value="NON_URGENTE">Non urgente</option></select><label class="form-label">Question / Données et analyses</label><textarea class="form-control mb-3" name="question" maxlength="3000" required></textarea><button class="btn btn-primary">Envoyer la demande</button></form></section></c:if></c:if>
<c:if test="${not empty consultation.expertiseRequest}"><section class="card card-body mb-4"><h2 class="h5">Expertise</h2><p><c:out value="${consultation.expertiseRequest.specialist.fullName}"/> · <c:out value="${consultation.expertiseRequest.priority}"/> · <c:out value="${consultation.expertiseRequest.status}"/></p><p>Question : <c:out value="${consultation.expertiseRequest.question}"/></p><p>Avis : <c:out value="${consultation.expertiseRequest.opinion}"/></p><p>Recommandations : <c:out value="${consultation.expertiseRequest.recommendations}"/></p></section></c:if><a href="${ctx}/doctor/consultations">Retour aux consultations</a>
<%@ include file="../shared/footer.jspf" %>
