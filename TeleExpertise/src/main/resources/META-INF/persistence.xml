<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence" version="3.1">
 <persistence-unit name="teleexpertise" transaction-type="RESOURCE_LOCAL">
  <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
  <class>ma.teleexpertise.entity.User</class>
  <class>ma.teleexpertise.entity.Nurse</class>
  <class>ma.teleexpertise.entity.GeneralPractitioner</class>
  <class>ma.teleexpertise.entity.Specialist</class>
  <class>ma.teleexpertise.entity.Patient</class>
  <class>ma.teleexpertise.entity.VitalSigns</class>
  <class>ma.teleexpertise.entity.Consultation</class>
  <class>ma.teleexpertise.entity.MedicalAct</class>
  <class>ma.teleexpertise.entity.ExpertiseRequest</class>
  <class>ma.teleexpertise.entity.TimeSlot</class>
  <exclude-unlisted-classes>true</exclude-unlisted-classes>
  <properties>
   <property name="hibernate.hbm2ddl.auto" value="validate"/>
   <property name="hibernate.show_sql" value="false"/>
   <property name="hibernate.connection.provider_class" value="ma.teleexpertise.util.HikariConnectionProvider"/>
  </properties>
 </persistence-unit>
</persistence>
